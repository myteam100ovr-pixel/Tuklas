{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tuklas Mobile (Android emulator)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}\\tuklas_mobile\\lib\\main.dart",
      "cwd": "${workspaceFolder}\\tuklas_mobile",
      "toolArgs": [
        "--dart-define=API_BASE=http://127.0.0.1:8000/api/mobile"
      ],
      "preLaunchTask": "Tuklas: check database and start mobile API"
    }
  ]
}
